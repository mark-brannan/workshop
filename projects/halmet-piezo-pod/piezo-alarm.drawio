      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;HALMET piezo alarm, engine-room pod&lt;/b&gt; &amp;nbsp;one wire out: GPIO 32 triggers an XY-MOS module in the pod" style="whiteSpace=wrap;html=1;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="950" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="400" height="350" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;HALMET box&lt;/b&gt; (dashed)" style="whiteSpace=wrap;html=1;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#444444;align=right;" vertex="1" parent="1"><mxGeometry x="215" y="376" width="200" height="30" as="geometry"/></mxCell><mxCell id="c5" value="" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="260" height="290" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;HALMET&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="48" y="82" width="100" height="25" as="geometry"/></mxCell><mxCell id="c7" value="" style="whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="200" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;J201&lt;/b&gt; GPIO 2x10 header" style="whiteSpace=wrap;html=1;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="105" y="112" width="195" height="20" as="geometry"/></mxCell><mxCell id="c9" value="pin 8 &amp;nbsp;GPIO 32" style="whiteSpace=wrap;html=