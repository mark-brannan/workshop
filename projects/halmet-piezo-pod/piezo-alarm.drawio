      <root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;HALMET piezo alarm, engine-room pod&lt;/b&gt; &amp;nbsp;GPIO 32 triggers an XY-MOS module that switches the buzzer low-side off boat 12 V" style="whiteSpace=wrap;html=1;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1220" height="30" as="geometry"/></mxCell><mxCell id="c3" value="" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="400" height="370" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;HALMET box&lt;/b&gt; (dashed), nothing added inside" style="whiteSpace=wrap;html=1;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="488" width="300" height="30" as="geometry"/></mxCell><mxCell id="c5" value="" style="whiteSpace=wrap;html=1;fontSize=13;rounded=1;fillColor=#F5F5F5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="260" height="310" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;HALMET&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="50" y="175" width="240" height="25" as="geometry"/></mxCell><mxCell id="c7" value="" style="whiteSpace=wrap;html=1;fontSize=13;fillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="200" height="170" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;J201&lt;/b&gt; GPIO 2x10 header" style="whiteSpace=wrap;html=1;fontSize=13;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="105" y="252" width="195" height="20" as="geometry"/></mxCell><mxCell id="c9" value="pin 8 &amp;nbsp;